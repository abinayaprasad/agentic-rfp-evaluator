# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Community Cloud, paste the same keys under App settings -> Secrets.
# Never commit the real secrets.toml.

# Provider: "openai", "openrouter", "anthropic", or "mock" (no key, keyword scorer for demos/tests)
LLM_PROVIDER = "openai"

# API key for the chosen provider.
LLM_API_KEY  = "your-api-key-here"

# Model id. Defaults if omitted:
#   openai     -> "gpt-4o-mini"
#   openrouter -> "openai/gpt-4o-mini"   (free-tier examples: "meta-llama/llama-3.3-70b-instruct:free")
#   anthropic  -> "claude-opus-5-5"
LLM_MODEL    = "gpt-4o-mini"

# Optional: override the endpoint for OpenAI-compatible providers.
# openrouter defaults to https://openrouter.ai/api/v1 so this is normally not needed.
# LLM_BASE_URL = ""

# Optional: corporate proxy fallback for outbound API calls. Used only when the
# terminal that launched Streamlit lacks these environment variables.
# HTTPS_PROXY = "http://proxy.example.com:8080"
# HTTP_PROXY  = "http://proxy.example.com:8080"
# NO_PROXY    = "localhost"
